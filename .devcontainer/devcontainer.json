{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "runArgs": ["--gpus", "all"],
  "settings": {
      "terminal.integrated.shell.linux": "/bin/bash"
  },
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "python3 -m pip install -r requirements.txt",
  "postCreateCommand": "",
  "customizations": {
    "codespaces": {
      "openFiles": []
    },
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python"
      ]
    }
  }
}
